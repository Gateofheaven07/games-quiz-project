generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// 👤 USER (USER + ADMIN)
//
model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String

  role Role @default(USER) // 🔥 penting

  level      Int @default(0)
  avatar     String?
  totalScore Int @default(0)
  wins       Int @default(0)
  losses     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameResults GameResult[]
  rooms       RoomPlayer[]
  logs        AdminLog[]

  // Friendship relations
  friendsSent     Friendship[] @relation("FriendshipSender")
  friendsReceived Friendship[] @relation("FriendshipReceiver")

  // Messages
  messagesSent Message[] @relation("MessageSender")

  // Notifications
  notificationsSent     Notification[] @relation("NotificationSender")
  notificationsReceived Notification[] @relation("NotificationReceiver")
}

//
// 🤝 FRIENDSHIP
//
model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

//
// 💬 MESSAGE
//
model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  notifications Notification[]
}

//
// 🎮 ROOM
//
model Room {
  id   String @id @default(uuid())
  code String @unique

  status     RoomStatus @default(WAITING)
  maxPlayers Int        @default(2)

  createdAt DateTime @default(now())

  players RoomPlayer[]
  game    Game?

  notifications Notification[]
}

//
// 👥 ROOM PLAYER
//
model RoomPlayer {
  id String @id @default(uuid())

  userId String
  roomId String

  score   Int     @default(0)
  isReady Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

//
// 🧠 GAME
//
model Game {
  id     String @id @default(uuid())
  roomId String @unique

  mode   GameMode
  status GameStatus @default(WAITING)

  // 🤖 Bot mode fields
  isVsBot       Boolean        @default(false)
  botDifficulty BotDifficulty?
  // 📊 Kategori skor: PRACTICE (vs bot) tidak masuk leaderboard global
  gameCategory  GameCategory   @default(GLOBAL)

  startedAt DateTime?
  endedAt   DateTime?
  winnerId  String?
  isDraw    Boolean @default(false)

  room        Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questions   GameQuestion[]
  gameResults GameResult[]
}

//
// ❓ QUESTION
//
model Question {
  id String @id @default(uuid())

  question String
  options  Json
  answer   String

  category   String?
  difficulty String?

  createdAt DateTime @default(now())

  gameQuestions GameQuestion[]
}

//
// 🔗 GAME QUESTION
//
model GameQuestion {
  id String @id @default(uuid())

  gameId     String
  questionId String

  order Int

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

//
// 🏆 GAME RESULT
//
model GameResult {
  id String @id @default(uuid())

  userId String
  gameId String

  score       Int
  finalScore  Int?
  isWinner    Boolean
  isDraw      Boolean @default(false)
  timeSpentMs Int     @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

//
// 🛠️ ADMIN LOG (OPSIONAL TAPI BAGUS)
//
model AdminLog {
  id String @id @default(uuid())

  userId String // admin yang melakukan aksi
  action String // contoh: "CREATE_QUESTION"
  detail String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// 📊 ENUM
//
enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum GameStatus {
  WAITING
  STARTED
  FINISHED
}

enum GameMode {
  QUIZ
  CROSSWORD
  TETRIS
}

enum BotDifficulty {
  EASY
  MEDIUM
  HARD
}

// PRACTICE = vs Bot (tidak masuk leaderboard global)
// GLOBAL   = vs Human (masuk leaderboard)
enum GameCategory {
  GLOBAL
  PRACTICE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

//
// 🔔 NOTIFICATION
//
model Notification {
  id         String             @id @default(uuid())
  type       NotificationType
  senderId   String
  receiverId String
  status     NotificationStatus @default(UNREAD)

  messageId  String?
  roomId     String? // for BATTLE_INVITE

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  sender   User @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  MESSAGE
  BATTLE_INVITE
}

enum NotificationStatus {
  READ
  UNREAD
}
