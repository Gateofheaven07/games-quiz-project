generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// 👤 USER (USER + ADMIN)
//
model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String

  role Role @default(USER) // 🔥 penting

  level      Int @default(1)
  totalScore Int @default(0)
  wins       Int @default(0)
  losses     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameResults GameResult[]
  rooms       RoomPlayer[]
  logs        AdminLog[]

  // Friendship relations
  friendsSent     Friendship[] @relation("FriendshipSender")
  friendsReceived Friendship[] @relation("FriendshipReceiver")

  // Messages
  messagesSent Message[] @relation("MessageSender")
}

//
// 🤝 FRIENDSHIP
//
model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id])
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

//
// 💬 MESSAGE
//
model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender User @relation("MessageSender", fields: [senderId], references: [id])
}

//
// 🎮 ROOM
//
model Room {
  id   String @id @default(uuid())
  code String @unique

  status     RoomStatus @default(WAITING)
  maxPlayers Int        @default(2)

  createdAt DateTime @default(now())

  players RoomPlayer[]
  game    Game?
}

//
// 👥 ROOM PLAYER
//
model RoomPlayer {
  id String @id @default(uuid())

  userId String
  roomId String

  score   Int     @default(0)
  isReady Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
}

//
// 🧠 GAME
//
model Game {
  id     String @id @default(uuid())
  roomId String @unique

  mode   GameMode
  status GameStatus @default(WAITING)

  startedAt DateTime?
  endedAt   DateTime?

  room        Room           @relation(fields: [roomId], references: [id])
  questions   GameQuestion[]
  gameResults GameResult[]
}

//
// ❓ QUESTION
//
model Question {
  id String @id @default(uuid())

  question String
  options  Json
  answer   String

  category   String?
  difficulty String?

  createdAt DateTime @default(now())

  gameQuestions GameQuestion[]
}

//
// 🔗 GAME QUESTION
//
model GameQuestion {
  id String @id @default(uuid())

  gameId     String
  questionId String

  order Int

  game     Game     @relation(fields: [gameId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
}

//
// 🏆 GAME RESULT
//
model GameResult {
  id String @id @default(uuid())

  userId String
  gameId String

  score    Int
  isWinner Boolean

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
}

//
// 🛠️ ADMIN LOG (OPSIONAL TAPI BAGUS)
//
model AdminLog {
  id String @id @default(uuid())

  userId String // admin yang melakukan aksi
  action String // contoh: "CREATE_QUESTION"
  detail String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

//
// 📊 ENUM
//
enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum GameStatus {
  WAITING
  STARTED
  FINISHED
}

enum GameMode {
  QUIZ
  CROSSWORD
  TETRIS
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}
